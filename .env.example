# CivicCare Tunis — variables d'environnement (exemple, aucun secret réel)
# Copiez ce fichier vers .env puis adaptez les valeurs.

# ===== Base de données =====
DB_PASSWORD=changez-moi-en-local
# Port hôte du PostgreSQL du compose (55432 pour éviter les conflits avec un PG local)
DB_HOST_PORT=55432

# ===== Profils applicatifs =====
# demo : seed de démonstration Tunis (jamais en production)
APP_PROFILES=demo
DEMO_SEED=true

# ===== Comptes internes (bootstrap) =====
# Hors production, un mot de passe local de développement est utilisé si vide (voir README).
# En production, un compte sans variable n'est PAS créé.
ADMIN_BOOTSTRAP_PASSWORD=
MODERATOR_BOOTSTRAP_PASSWORD=
AGENT_BOOTSTRAP_PASSWORD=

# ===== Ville / pays cible (Tunis, Tunisie par défaut) =====
# Nom public affiché dans l'en-tête et la page de connexion
APP_NAME=CivicCare Tunis
# Pays ISO 3166-1 alpha-2 : filtre du géocodeur et région téléphonique par défaut
APP_COUNTRY=TN
# Région téléphonique si différente du pays (sinon laisser vide : suit APP_COUNTRY)
APP_PHONE_REGION=
# Fuseau IANA
APP_TIMEZONE=Africa/Tunis
# Cadrage initial de la carte
MAP_CENTER_LAT=36.8065
MAP_CENTER_LON=10.1815
MAP_INITIAL_ZOOM=12.5

# ===== Géographie =====
# DEMO (défaut) : périmètre de démonstration approximant la commune de Tunis (non officiel).
# OSM_AGGLO : agglomération OSM relation 8896976 (n'est PAS la municipalité).
# Autre valeur : code d'un contour vérifié chargé par l'exploitant.
GEO_BOUNDARY_SOURCE=DEMO
# Doit être true pour autoriser le profil production (après validation humaine du contour).
GEO_BOUNDARY_VALIDATED=false

# DEMO : géocodeur local sans réseau. NOMINATIM : instance auto-hébergée ou fournisseur
# dont les conditions ont été vérifiées (JAMAIS le serveur public par défaut).
GEOCODER_MODE=DEMO
GEOCODER_BASE_URL=
GEOCODER_EMAIL=

# Fournisseur de tuiles (attribution obligatoire, conditions à vérifier)
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_TILE_ATTRIBUTION=© OpenStreetMap contributors (ODbL)

# ===== Bandeau urgences =====
# Ne renseignez des numéros qu'après vérification sur une source tunisienne officielle,
# en documentant la source et la date dans docs/tunis-configuration.md.
EMERGENCY_VERIFIED=false
EMERGENCY_SOURCE=
EMERGENCY_VERIFIED_ON=

# ===== Observabilité =====
# true : télémétrie désactivée (fonctionnement sans collector). false avec le profil observability.
OTEL_SDK_DISABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
GRAFANA_ADMIN_PASSWORD=grafana-demo

# ===== Divers =====
# URL publique de base pour les liens des e-mails
# CIVICCARE_BASE_URL=http://localhost:8080
