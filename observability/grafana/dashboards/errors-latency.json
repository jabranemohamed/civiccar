{
 "uid": "cc-errors",
 "title": "CivicCare \u2014 Erreurs et latence",
 "schemaVersion": 39,
 "version": 1,
 "time": {
  "from": "now-3h",
  "to": "now"
 },
 "refresh": "30s",
 "panels": [
  {
   "id": 1,
   "title": "Erreurs HTTP 5xx / s",
   "type": "timeseries",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "sum(rate(http_server_request_duration_seconds_count{http_response_status_code=~\"5..\"}[5m]))",
     "refId": "A",
     "legendFormat": null
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   }
  },
  {
   "id": 2,
   "title": "R\u00e9ponses par code",
   "type": "timeseries",
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "sum(rate(http_server_request_duration_seconds_count[5m])) by (http_response_status_code)",
     "refId": "A",
     "legendFormat": null
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   }
  },
  {
   "id": 3,
   "title": "Dur\u00e9e des cas d'usage p95 (ms)",
   "type": "timeseries",
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 24,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.95, sum(rate(civiccare_usecase_duration_bucket[5m])) by (le, civiccare_usecase))",
     "refId": "A",
     "legendFormat": null
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   }
  }
 ],
 "tags": [
  "civiccare"
 ]
}